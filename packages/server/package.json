{
  "name": "@hellfall/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "build:prod": "esbuild src/server.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/server.mjs --external:@google-cloud/firestore --external:@google-cloud/storage --external:dotenv --external:@xmldom/xmldom",
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "start:prod": "node dist/server.js",
    "test": "tsx --test src/lib/imageGcs.test.ts src/lib/catalogStreamExport.test.ts"
  },
  "dependencies": {
    "@google-cloud/firestore": "^7.1.0",
    "@google-cloud/storage": "^7.22.0",
    "@hellfall/shared": "^1.0.0",
    "dotenv": "^16.4.5",
    "jose": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
